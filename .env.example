# Telegram Bot Token (t.me/BotFather orqali olinadi)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key (https://aistudio.google.com/ orqali bepul olinadi)
GEMINI_API_KEY=your_gemini_api_key_here

# Darslar o'tiladigan Telegram guruh ID raqami
# (Agar kiritilmasa, bot o'zi qo'shilgan guruhni avtomatik aniqlab oladi)
# Masalan: -1001234567890
TELEGRAM_GROUP_ID=

# Bot administratorining Telegram ID raqami (hisobot va xato xabarlari uchun)
# Telegram ilovasida @userinfobot ga /start yuboring — u sizning ID raqamingizni ko'rsatadi
ADMIN_TELEGRAM_ID=

# Bir nechta Gemini API kaliti (vergul bilan ajratiladi — load balancing uchun)
GEMINI_API_KEYS=your_key_1,your_key_2

# SQLite ma'lumotlar bazasi fayl yo'li
DATABASE_PATH=./bot.db

# Avtonom darslar jadvali (soatlarda, 0-23)
# Ertalabki nazariya darsi soati (standart: 9:00)
MORNING_HOUR=9

# Tushlikdagi viktorina (Quiz) soati (standart: 14:00)
AFTERNOON_HOUR=14

# Kechki kod topshirig'i (Challenge) soati (standart: 19:00)
EVENING_HOUR=19

# Jimjitlik eslatmasi (Nudge) soati (standart: 21:00)
NUDGE_HOUR=21

# Tokensiz lokal sinab ko'rish uchun (true / false)
DRY_RUN=false
